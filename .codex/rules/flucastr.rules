# flucastr-ai:generado - no editar; se regenera con instalar.sh
prefix_rule(
    pattern = ["git","commit"],
    decision = "forbidden",
    justification = "Lo hace el mantenedor: flucastr-ai no hace commit, push, merge ni PR.",
    match = [["git","commit","x"]],
)

prefix_rule(
    pattern = ["git","push"],
    decision = "forbidden",
    justification = "Lo hace el mantenedor: flucastr-ai no hace commit, push, merge ni PR.",
    match = [["git","push","x"]],
)

