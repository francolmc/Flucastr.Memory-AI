{
  "name": "flucastr-memory-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/src/**",
    "integrations/**",
    "README.md"
  ],
  "bin": {
    "mem": "dist/src/mem.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json",
    "cli": "node dist/src/cli.js",
    "verify": "npm run typecheck && npm run build && npm test && npm run cli -- --help && npm run cli -- doctor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
