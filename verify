#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

valid_url() {
  node --input-type=module - "$1" <<'NODE'
const raw = process.argv[2];
try {
  const u = new URL(raw);
  if (!['http:', 'https:'].includes(u.protocol) || !u.hostname || u.username || u.password || u.search || u.hash) process.exit(1);
} catch { process.exit(1); }
NODE
}

# Remote mode is selected and validated before any Docker/npm preflight.
if [[ -n "${VERIFY_TARGET:-}" ]]; then
  valid_url "$VERIFY_TARGET" || { echo 'VERIFY FAIL: VERIFY_TARGET inválido' >&2; exit 2; }
  api="${API_URL:-$VERIFY_TARGET}"
  web="${WEB_URL:-$VERIFY_TARGET}"
  valid_url "$api" || { echo 'VERIFY FAIL: API_URL inválida' >&2; exit 2; }
  valid_url "$web" || { echo 'VERIFY FAIL: WEB_URL inválida' >&2; exit 2; }
  if [[ -z "${MEM_TOKEN:-}" || ! "$MEM_TOKEN" =~ ^[A-Za-z0-9._~-]+$ ]]; then echo 'VERIFY FAIL: falta MEM_TOKEN válido por entorno' >&2; exit 2; fi
  echo "MODO REMOTO: $VERIFY_TARGET"
  if [[ "${VERIFY_PERMITIR_ESCRITURA:-}" == 1 ]]; then
    VERIFY_URL="$api" VERIFY_WRITE=1 node "$ROOT/scripts/verify-flujo.mjs"
  else
    VERIFY_URL="$api" VERIFY_WRITE=0 node "$ROOT/scripts/verify-flujo.mjs"
  fi
  exit $?
fi

project="verify_memory_$$"
cleanup_registered=0
success_output=''
active_pid=''
run_timed() {
  local duration="$1" grace="$2" rc=0
  shift 2
  timeout -k "$grace" "$duration" "$@" &
  active_pid=$!
  wait "$active_pid" || rc=$?
  active_pid=''
  return "$rc"
}
cleanup() {
  local rc=$?
  trap - EXIT INT TERM
  if [[ "$cleanup_registered" == 1 ]]; then
    if ! timeout -k 2s 60s docker compose -p "$project" -f "$ROOT/docker-compose.verify.yml" down -v --remove-orphans; then
      echo 'VERIFY FAIL: limpieza Compose falló' >&2
      rc=1
    else
      echo 'LIMPIEZA OK'
      if [[ "$rc" == 0 && -n "$success_output" ]]; then printf '%s\n' "$success_output"; fi
    fi
  fi
  exit "$rc"
}
terminate() {
  if [[ -n "$active_pid" ]]; then
    kill -TERM "$active_pid" 2>/dev/null || true
    wait "$active_pid" 2>/dev/null || true
    active_pid=''
  fi
  exit 130
}
trap cleanup EXIT
trap terminate INT TERM

step='preflight Docker'
if run_timed 15s 2s docker info --format '{{.ServerVersion}}'; then :; else rc=$?; echo "VERIFY FAIL: $step (código $rc)" >&2; exit "$rc"; fi
cleanup_registered=1
step='build acceptance'
args=(build)
[[ "${VERIFY_RAPIDO:-}" == 1 ]] || args+=(--no-cache)
if run_timed 480s 5s docker compose -p "$project" -f "$ROOT/docker-compose.verify.yml" "${args[@]}"; then :; else rc=$?; echo "VERIFY FAIL: $step (código $rc)" >&2; exit "$rc"; fi
step='arranque Compose'
if run_timed 60s 2s docker compose -p "$project" -f "$ROOT/docker-compose.verify.yml" up -d; then :; else rc=$?; echo "VERIFY FAIL: $step (código $rc)" >&2; exit "$rc"; fi
step='readiness HTTP loopback'
deadline=$((SECONDS + 60))
ready=0
while (( SECONDS < deadline )); do
  if run_timed 5s 1s docker compose -p "$project" -f "$ROOT/docker-compose.verify.yml" exec -T memory node /app/scripts/verify-flujo.mjs >/dev/null 2>&1; then ready=1; break; fi
  sleep 1
done
if [[ "$ready" != 1 ]]; then echo "VERIFY FAIL: $step (timeout 60s)" >&2; exit 1; fi
step='flujo HTTP/SQLite'
if success_output="$(run_timed 60s 2s docker compose -p "$project" -f "$ROOT/docker-compose.verify.yml" exec -T memory env VERIFY_WRITE=1 node /app/scripts/verify-flujo.mjs)"; then :; else rc=$?; echo "VERIFY FAIL: $step (código $rc)" >&2; exit "$rc"; fi
